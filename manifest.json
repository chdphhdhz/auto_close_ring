{
    "manifest_version": 3,
    "name": "关闭页面_定时",
    "version": "2.0",
    "description": "",
    "permissions": [
        "tabs",
        "storage",
        "scripting",
        "background"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "关闭页面_定时",
        "default_icon": "icon.png"
    },
    "icons": {
        "128": "icon.png"
    }
}